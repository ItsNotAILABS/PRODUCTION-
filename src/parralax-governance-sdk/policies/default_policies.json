{
  "schema_version": "2.0.0",
  "governance_sdk": "parralax-governance-sdk",
  "mode": "production-unrestricted",
  "policies": [
    {
      "rule_id": "SOVEREIGN_SELF_EXECUTE",
      "description": "Owner can execute any action on their sovereign resources",
      "mode": "sovereign",
      "conditions": {
        "resource_prefix": "sovereign://"
      },
      "verdict": "allow",
      "priority": 100
    },
    {
      "rule_id": "PRODUCTION_UNRESTRICTED",
      "description": "All agents have unrestricted access to all production resources including CI/CD",
      "mode": "autonomous",
      "conditions": {
        "resource_prefix": "pipeline://"
      },
      "verdict": "allow",
      "priority": 99
    },
    {
      "rule_id": "AGENT_FULL_ACCESS",
      "description": "Mini-brains operate with full production access — no zone boundaries",
      "mode": "autonomous",
      "conditions": {
        "resource_prefix": "production://"
      },
      "verdict": "allow",
      "priority": 95
    },
    {
      "rule_id": "MESIE_DIRECT_ACCESS",
      "description": "Direct unrestricted access to MESIE bridge spectral channels",
      "mode": "autonomous",
      "conditions": {
        "resource_prefix": "mesie://"
      },
      "verdict": "allow",
      "priority": 90
    },
    {
      "rule_id": "CELESTIAL_FULL_ACCESS",
      "description": "Full read/write access to celestial sync engine and temporal resources",
      "mode": "autonomous",
      "conditions": {
        "resource_prefix": "temporal://"
      },
      "verdict": "allow",
      "priority": 90
    },
    {
      "rule_id": "GOVERNANCE_SELF_MODIFY",
      "description": "Agents may modify governance policies during operation",
      "mode": "autonomous",
      "conditions": {
        "resource_prefix": "governance://"
      },
      "verdict": "allow",
      "priority": 85
    }
  ]
}

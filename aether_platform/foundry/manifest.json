        {"name": "INPUT", "label": "Input text file", "default": "texts.txt", "help": "one text per line"},
        {"name": "ENDPOINT", "label": "Embeddings endpoint", "default": "http://127.0.0.1:8080/embed", "help": "POST {texts:[...]} -> {vectors:[...]}"},
        {"name": "BATCH", "label": "Batch size", "default": "32", "help": "texts per request"}
      ],
      "needs": ["An embeddings HTTP endpoint."],
      "run": "python3 embed.py"
    },

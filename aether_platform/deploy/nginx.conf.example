# Example reverse proxy for the Aether Platform API, terminating TLS and
# forwarding to the stdlib HTTP server on 127.0.0.1:7700.
#
# Copy to /etc/nginx/sites-available/aether-platform, symlink into
# sites-enabled, then run `certbot --nginx -d your-domain.example.com`
# to provision TLS automatically.

server {
    listen 80;
    server_name your-domain.example.com;

    location / {
        proxy_pass http://127.0.0.1:7700;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

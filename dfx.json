{
  "version": 1,
  "dfx": "0.22.0",
  "canisters": {
    "organism_backend": {
      "type": "motoko",
      "main": "organism/motoko/src/Organism.mo"
    },
    "organism_frontend": {
      "type": "assets",
      "source": ["icp-dist"],
      "dependencies": ["organism_backend"]
    },
    "governance_canister": {
      "type": "motoko",
      "main": "organism/motoko/src/Governance.mo",
      "dependencies": ["organism_backend"]
    },
    "celestial_sync_canister": {
      "type": "motoko",
      "main": "organism/motoko/src/CelestialSync.mo",
      "dependencies": ["governance_canister"]
    }
  },
  "networks": {
    "local": { "bind": "127.0.0.1:4943", "type": "ephemeral" },
    "ic": { "providers": ["https://icp0.io"], "type": "persistent" }
  },
  "output_env_file": ".env"
}

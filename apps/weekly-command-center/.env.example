# Copy to .env and fill in before running docker-compose.prod.yml.
# Local dev (run_local.sh / docker-compose.yml) needs none of this — it
# defaults to SQLite and an insecure dev-only JWT secret on purpose.

# --- Postgres ---
POSTGRES_USER=wcc
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=weekly_command_center

# --- Auth ---
# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRY_HOURS=24

# --- CORS ---
# The exact origin your frontend is served from. No wildcards in production.
CORS_ORIGINS=https://app.yourdomain.com

# --- Billing (fill in once you have a real Stripe account; see stripe_client.py) ---
# Both are required together — the app treats Stripe as disabled unless both are set.
# STRIPE_API_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Email (optional; falls back to console-log if none of these are set) ---
# Option A: SendGrid
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=noreply@yourdomain.com
# Option B: AWS SES
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# SES_FROM_EMAIL=noreply@yourdomain.com
# Option C: SMTP
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=noreply@yourdomain.com

# --- Supercomputer mode (optional; all default to false/disabled) ---
# ENABLE_SUPERCOMPUTE=true
# ENABLE_ML_OPTIMIZER=true
# ENABLE_DISTRIBUTED=true
# ENABLE_GPU=true
# ENABLE_REALTIME=true
# REDIS_URL=redis://redis:6379/0
# RAY_HEAD_NODE=127.0.0.1:6379
